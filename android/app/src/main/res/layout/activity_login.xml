<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp"
        android:gravity="center_horizontal">

        <!-- Top Header with App Logo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_cyclecare_logo"
                android:contentDescription="CycleCare Logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="CYCLECARE"
                android:textColor="@color/colorPrimary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <!-- Horizontal Mascot Section: Transparent Animated Panda on LEFT, Message on RIGHT -->
        <LinearLayout
            android:id="@+id/ll_mascot_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 3D Mascot on the LEFT SIDE (Transparent PNG, No White Background Box) -->
            <FrameLayout
                android:id="@+id/fl_panda_frame"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@drawable/bg_neu_dial_outer"
                android:padding="6dp">

                <ImageView
                    android:id="@+id/iv_panda"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/panda_idle"
                    android:scaleType="fitCenter"
                    android:contentDescription="CycleCare 3D Mascot" />
            </FrameLayout>

            <!-- Speech Card on the RIGHT SIDE (Soft Neumorphic) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_neu_card_raised"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome Back"
                    android:textColor="#000000"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_panda_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Hi there! Enter your email to begin."
                    android:textColor="@color/colorPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Soft Neumorphic Login Card (Extruded Dual Shadow) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_neu_card_raised"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SIGN IN"
                android:textColor="#000000"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Encrypted offline cycle space"
                android:textColor="#334155"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Email Label & Inset Input (Bold Solid Black Font) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="EMAIL ADDRESS"
                android:textColor="#000000"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <EditText
                android:id="@+id/et_email"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/neu_input"
                android:hint="Enter your email"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="16dp"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textColorHint="#94A3B8"
                android:textSize="15sp" />

            <!-- Password Label & Inset Input (Bold Solid Black Font) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="PASSWORD"
                android:textColor="#000000"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <EditText
                android:id="@+id/et_password"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/neu_input"
                android:hint="Enter your password"
                android:inputType="textPassword"
                android:paddingHorizontal="16dp"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textColorHint="#94A3B8"
                android:textSize="15sp" />

            <!-- Forgot Password Link -->
            <TextView
                android:id="@+id/tv_forgot_password"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:text="Forgot Password?"
                android:textColor="@color/colorPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Terms & Privacy Agreement Checkbox -->
            <CheckBox
                android:id="@+id/cb_login_terms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:checked="true"
                android:text="I agree to Terms &amp; Conditions and Privacy Policy"
                android:textColor="#475569"
                android:textSize="11sp" />

            <!-- Elevated Pill Button -->
            <Button
                android:id="@+id/btn_login"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_m3_button"
                android:text="SIGN IN"
                android:textColor="@color/textOnPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Create Account Link -->
        <TextView
            android:id="@+id/tv_go_register"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:padding="10dp"
            android:text="Don't have an account? Create account"
            android:textColor="@color/colorPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- 1-Tap Demo Accounts Selector -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="QUICK 1-TAP DEMO LOGINS"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Demo 1: Girl (Aastha) -->
            <Button
                android:id="@+id/btn_demo_girl_login"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_neu_card_raised"
                android:text="🌸 Girl (Aastha)"
                android:textColor="#E91E63"
                android:textSize="11sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <!-- Demo 2: Husband (Rahul) -->
            <Button
                android:id="@+id/btn_demo_husband_login"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_neu_card_raised"
                android:text="👨 Husband (Aman)"
                android:textColor="#2563EB"
                android:textSize="11sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <!-- Demo 3: Delivery Courier -->
            <Button
                android:id="@+id/btn_demo_delivery_login"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_neu_card_raised"
                android:text="🚴 Delivery Agent"
                android:textColor="#059669"
                android:textSize="11sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_admin_panel_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="28dp"
            android:text="💻 Website Admin: admin@cyclecare.app • AdminPassword123!"
            android:textColor="#64748B"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
