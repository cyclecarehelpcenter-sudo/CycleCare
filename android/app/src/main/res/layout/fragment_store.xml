<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground"
    android:padding="16dp">

    <!-- Store Header with Action Icons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Care Kit &amp; Comfort Store"
                android:textColor="#000000"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Curated essentials &amp; discreet comfort kits"
                android:textColor="@color/textSecondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Orders Action -->
        <ImageButton
            android:id="@+id/btn_store_orders"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_orders"
            app:tint="#2D3748"
            android:contentDescription="My Orders" />

        <!-- Cart Action with Badge -->
        <FrameLayout
            android:id="@+id/btn_store_cart"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_cart"
                app:tint="#2D3748" />

            <TextView
                android:id="@+id/tv_store_cart_badge"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_badge_count"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Category Horizontal Chips Scroll -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/chip_all"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_m3_button"
                android:paddingHorizontal="18dp"
                android:text="All Essentials"
                android:textColor="@color/textOnPrimary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/chip_period_care"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="16dp"
                android:text="Period Care"
                android:textColor="#000000"
                android:textSize="11sp"
                android:textStyle="bold"
                app:cornerRadius="19dp"
                app:strokeColor="@color/colorGlassBorder" />

            <Button
                android:id="@+id/chip_comfort"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="16dp"
                android:text="Comfort Kits"
                android:textColor="#000000"
                android:textSize="11sp"
                android:textStyle="bold"
                app:cornerRadius="19dp"
                app:strokeColor="@color/colorGlassBorder" />

            <Button
                android:id="@+id/chip_hygiene"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="16dp"
                android:text="Hygiene &amp; Wipes"
                android:textColor="#000000"
                android:textSize="11sp"
                android:textStyle="bold"
                app:cornerRadius="19dp"
                app:strokeColor="@color/colorGlassBorder" />

            <Button
                android:id="@+id/chip_teas"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:paddingHorizontal="16dp"
                android:text="Soothing Teas"
                android:textColor="#000000"
                android:textSize="11sp"
                android:textStyle="bold"
                app:cornerRadius="19dp"
                app:strokeColor="@color/colorGlassBorder" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Product Grid View -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_products"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

</LinearLayout>
