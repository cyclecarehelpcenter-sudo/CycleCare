<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Bottom sheet drag handle -->
    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/colorBorder" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="💬 Connect with Partner or Family"
        android:textColor="@color/textPrimary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Add husbands, partners, or circle members for real-time care &amp; chats"
        android:textColor="@color/textSecondary"
        android:textSize="12sp" />

    <!-- Search Input Box -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="FIND USER BY NAME OR EMAIL"
        android:textColor="@color/textSecondary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_box"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/et_new_chat_query"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="e.g. Aman, demo, admin, or email"
            android:textColor="@color/textPrimary"
            android:textColorHint="@color/textHint"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Relationship Tag Selection -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="SELECT RELATIONSHIP TAG"
        android:textColor="@color/textSecondary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/ll_tag_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/chip_tag_husband"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_m3_button"
                android:paddingHorizontal="14dp"
                android:text="Husband ❤️"
                android:textColor="@color/textOnPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/chip_tag_wife"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_neu_card_raised"
                android:paddingHorizontal="14dp"
                android:text="Wife 🌸"
                android:textColor="@color/textPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/chip_tag_friend"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_neu_card_raised"
                android:paddingHorizontal="14dp"
                android:text="Best Friend 💕"
                android:textColor="@color/textPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/chip_tag_sister"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_neu_card_raised"
                android:paddingHorizontal="14dp"
                android:text="Sister 🌷"
                android:textColor="@color/textPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/chip_tag_mom"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_neu_card_raised"
                android:paddingHorizontal="14dp"
                android:text="Mother 👵"
                android:textColor="@color/textPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/chip_tag_partner"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_neu_card_raised"
                android:paddingHorizontal="14dp"
                android:text="Partner 💍"
                android:textColor="@color/textPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Found User Preview Card (Initially Gone) -->
    <LinearLayout
        android:id="@+id/card_found_user_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_neu_card_raised"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_preview_avatar_letter"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_avatar_circle"
            android:gravity="center"
            android:text="A"
            android:textColor="@color/textOnPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_preview_user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aman Sharma"
                android:textColor="@color/textPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_preview_user_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="aman.husband@cyclecare.app"
                android:textColor="@color/textSecondary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_preview_tag_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_today"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Husband ❤️"
            android:textColor="@color/colorPrimary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Search or Connect Action Button -->
    <Button
        android:id="@+id/btn_action_find_or_connect"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_m3_button"
        android:text="Search &amp; Connect 🚀"
        android:textColor="@color/textOnPrimary"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
