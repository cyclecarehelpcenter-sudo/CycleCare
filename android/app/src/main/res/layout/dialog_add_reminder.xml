<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Handle -->
    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/colorBorder" />

    <TextView
        android:id="@+id/tv_dialog_reminder_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Add Cycle / Health Reminder"
        android:textColor="@color/textPrimary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Set personalized alerts with instant notification &amp; sound"
        android:textColor="@color/textSecondary"
        android:textSize="12sp" />

    <!-- Reminder Title Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="REMINDER TITLE"
        android:textColor="@color/textSecondary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" />

    <EditText
        android:id="@+id/et_reminder_title"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_box"
        android:hint="e.g. Take Iron Tablet, Drink Warm Water"
        android:paddingHorizontal="14dp"
        android:textColor="@color/textPrimary"
        android:textColorHint="@color/textHint"
        android:textSize="14sp" />

    <!-- Time Selection Row -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="SELECT ALERT TIME"
        android:textColor="@color/textSecondary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_time_midnight"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_m3_button"
            android:text="12:00 AM 🌙"
            android:textColor="@color/textOnPrimary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_time_morning"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_neu_card_raised"
            android:text="9:00 AM ☀️"
            android:textColor="@color/textPrimary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_time_night"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_neu_card_raised"
            android:text="9:00 PM 🍵"
            android:textColor="@color/textPrimary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_time_custom"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_neu_card_raised"
        android:text="⏰ Choose Custom Time (Click to pick time)"
        android:textColor="@color/colorPrimary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Save Button -->
    <Button
        android:id="@+id/btn_save_reminder"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_m3_button"
        android:text="Save &amp; Set Reminder ✓"
        android:textColor="@color/textOnPrimary"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
