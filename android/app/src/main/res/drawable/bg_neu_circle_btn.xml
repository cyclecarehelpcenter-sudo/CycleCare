<?xml version="1.0" encoding="utf-8"?>
<!-- Soft Neumorphic Circular Button -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="3dp" android:top="3dp">
        <shape android:shape="oval">
            <solid android:color="@color/neuDarkShadow" />
        </shape>
    </item>
    <item android:right="3dp" android:bottom="3dp">
        <shape android:shape="oval">
            <solid android:color="@color/neuLightHighlight" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="oval">
            <solid android:color="@color/neuSurface" />
        </shape>
    </item>
</layer-list>
