<?xml version="1.0" encoding="utf-8"?>
<!-- bg_input_box.xml: alias → neu_input for backward compat -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#C9C5CC" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#E8E5EC" />
            <corners android:radius="13dp" />
        </shape>
    </item>
</layer-list>
