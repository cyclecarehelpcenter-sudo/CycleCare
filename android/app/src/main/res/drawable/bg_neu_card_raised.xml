<?xml version="1.0" encoding="utf-8"?>
<!-- Soft Neumorphic Raised Metric Card (from reference mockup 3 cards on top) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="5dp" android:top="5dp">
        <shape android:shape="rectangle">
            <solid android:color="#CCD5E2" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:right="5dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#F4F7FB" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
