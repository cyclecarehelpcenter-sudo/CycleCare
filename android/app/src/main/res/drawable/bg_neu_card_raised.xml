<?xml version="1.0" encoding="utf-8"?>
<!-- Soft Neumorphic Raised Metric Card -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="5dp" android:top="5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neuDarkShadow" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:right="5dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neuLightHighlight" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neuSurface" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
