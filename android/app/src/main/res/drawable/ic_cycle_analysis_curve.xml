    <!-- Center Dot -->
    <path
        android:fillColor="#C2185B"
        android:pathData="M 277,35 A 5,5 0 1,1 276.9,35 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 277,35 A 2,2 0 1,1 276.9,35 Z" />

