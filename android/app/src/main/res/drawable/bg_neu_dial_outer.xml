<?xml version="1.0" encoding="utf-8"?>
<!-- Circular Extruded Neumorphic Dial Outer Ring -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark Shadow bottom-right -->
    <item android:left="6dp" android:top="6dp">
        <shape android:shape="oval">
            <solid android:color="@color/neuDarkShadow" />
        </shape>
    </item>
    <!-- Light Highlight top-left -->
    <item android:right="6dp" android:bottom="6dp">
        <shape android:shape="oval">
            <solid android:color="@color/neuLightHighlight" />
        </shape>
    </item>
    <!-- Raised Rim Surface -->
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="oval">
            <solid android:color="@color/neuSurface" />
            <stroke android:width="1.5dp" android:color="@color/colorBorder" />
        </shape>
    </item>
</layer-list>
