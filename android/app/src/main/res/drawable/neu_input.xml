<?xml version="1.0" encoding="utf-8"?>
<!-- Neumorphic Input: pressed/inset surface adapted for light and dark themes -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark shadow inset (top-left inner) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/neuDarkShadow" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Light shadow inset (bottom-right inner) -->
    <item android:left="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neuLightHighlight" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Main pressed inset surface with theme-aware background and border -->
    <item android:left="2dp" android:top="2dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/colorInputBackground" />
            <stroke android:width="1dp" android:color="@color/colorInputBorder" />
            <corners android:radius="13dp" />
        </shape>
    </item>
</layer-list>
