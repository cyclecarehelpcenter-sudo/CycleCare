# CycleCare Environment Variables Example

# SERVER CONFIGURATION
PORT=5000
NODE_ENV=development

# JWT SECURITY SECRETS (DO NOT COMMIT REAL SECRETS)
JWT_SECRET=super_secret_jwt_access_token_key_change_in_production
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_key_change_in_production
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# SUPABASE POSTGRESQL & STORAGE CONFIGURATION
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# PAYMENT GATEWAY (RAZORPAY)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# OPTIONAL OPENAI / GEMINI KEY FOR WELLNESS AI ASSISTANT
AI_SERVICE_API_KEY=your_ai_service_api_key

# ADMIN INITIALIZATION SECRET
ADMIN_SECRET_KEY=change_this_admin_creation_secret_key
